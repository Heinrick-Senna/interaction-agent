# AI provider: "openai" (default) or "anthropic"
AI_PROVIDER=openai

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

PORT=3000

# --- Docker overrides these automatically ---
# DB_PATH and EVOLUTION_API_URL are set in docker-compose.yml
# Fill the values below — they're shared between both containers

EVOLUTION_API_KEY=change_this_to_a_strong_secret
EVOLUTION_INSTANCE=my-instance

# Admin WhatsApp JID — receives "Agente iniciado" / "Reiniciando agente" notifications
# Format: countrycode + number + @s.whatsapp.net  (ex: 5511999999999@s.whatsapp.net)
ADMIN_JID=5511999999999@s.whatsapp.net

# --- Developer Agent (self-extending bot) ---
# Always uses Claude (ignores AI_PROVIDER). Defaults to claude-opus-4-8.
DEVELOPER_AGENT_MODEL=claude-sonnet-4-6
# GitHub Personal Access Token with repo scope (contents + pull_requests)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=Heinrick-Senna
GITHUB_REPO=interaction-agent
